# --- Server ---
PORT=3000

# --- Database ---
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://miniledger:miniledger@localhost:5432/miniledger

# --- Auth ---
# Any random string; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string

# --- OTP ---
OTP_TTL_SECONDS=300

# --- Uploads ---
UPLOAD_DIR=uploads
# The public URL where the backend is reachable (used to build receipt URLs)
PUBLIC_BASE_URL=http://localhost:3000
